---
import type { CollectionEntry } from 'astro:content';
import { url, asset } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
  delay?: number;
}

const { project, delay = 0 } = Astro.props;
const { title, blurb, tech, cover, status } = project.data;
const href = url(`/projects/${project.id}`);
const coverSrc = asset(cover);
---

<article class="panel panel--link project" data-reveal data-reveal-delay={delay}>
  {
    coverSrc && (
      <div class="project__media">
        <img src={coverSrc} alt="" loading="lazy" decoding="async" />
      </div>
    )
  }

  <div class="project__body">
    <div class="project__top">
      <h3 class="project__title display">
        <a class="stretched" href={href}>{title}</a>
      </h3>
      <span class="tag" data-status={status}>{status}</span>
    </div>

    <p class="project__blurb muted">{blurb}</p>

    {
      tech.length > 0 && (
        <ul class="tags project__tech">
          {tech.slice(0, 5).map((t) => (
            <li class="tag">{t}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0;
    overflow: hidden;
  }

  .project__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--abyss);
  }

  .project__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease);
  }

  .project:hover .project__media img {
    transform: scale(1.04);
  }

  .project__body {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    flex: 1;
  }

  .project__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .project__title {
    font-size: 1.15rem;
    letter-spacing: 0.03em;
  }

  .project__title a {
    color: inherit;
    text-decoration: none;
  }

  .project:hover .project__title {
    color: var(--cyan);
  }

  .project__blurb {
    flex: 1;
    font-size: var(--step-0);
  }

  .project__tech {
    margin-top: auto;
  }

  /* Status colours: only "Active" earns the amber highlight. */
  .tag[data-status='Active'] {
    color: var(--amber);
    background: var(--amber-soft);
    border-color: var(--amber-line);
  }

  .tag[data-status='Prototype'] {
    color: var(--cyan);
    background: var(--cyan-soft);
    border-color: var(--cyan-line);
  }
</style>
