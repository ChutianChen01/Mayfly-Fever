---
/**
 * Full-screen photo viewer.
 *
 * Drop this once on a page containing links marked `data-lightbox`, where each
 * link's `href` is the full-size image. Those links stay real links, so with
 * JavaScript disabled — or if this script fails — clicking a photo simply
 * opens the image file directly. Nothing becomes unreachable.
 *
 * Uses <dialog> for free focus trapping, Escape handling, and inertness of the
 * background content.
 */
---

<dialog class="lightbox" aria-label="Photo viewer">
  <button class="lightbox__close" type="button" aria-label="Close viewer">&times;</button>

  <button class="lightbox__nav lightbox__nav--prev" type="button" aria-label="Previous photo">
    &lsaquo;
  </button>

  <figure class="lightbox__figure">
    <img class="lightbox__img" src="" alt="" />
    <figcaption class="lightbox__caption"></figcaption>
  </figure>

  <button class="lightbox__nav lightbox__nav--next" type="button" aria-label="Next photo">
    &rsaquo;
  </button>

  <p class="lightbox__counter" aria-live="polite"></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const triggers = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]'),
  );

  if (dialog && triggers.length > 0) {
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    const counter = dialog.querySelector<HTMLElement>('.lightbox__counter')!;
    const prevBtn = dialog.querySelector<HTMLButtonElement>('.lightbox__nav--prev')!;
    const nextBtn = dialog.querySelector<HTMLButtonElement>('.lightbox__nav--next')!;
    const closeBtn = dialog.querySelector<HTMLButtonElement>('.lightbox__close')!;

    let index = 0;
    let lastFocused: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + triggers.length) % triggers.length;
      const trigger = triggers[index];
      img.src = trigger.href;
      img.alt = trigger.dataset.alt ?? '';
      const text = trigger.dataset.caption ?? '';
      caption.textContent = text;
      caption.hidden = text === '';
      counter.textContent = `${index + 1} / ${triggers.length}`;
      // Only one photo: the arrows would do nothing, so hide them.
      const single = triggers.length < 2;
      prevBtn.hidden = single;
      nextBtn.hidden = single;
    };

    triggers.forEach((trigger, i) => {
      trigger.addEventListener('click', (event) => {
        // Let modified clicks (new tab, download) behave normally.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        lastFocused = trigger;
        show(i);
        dialog.showModal();
      });
    });

    prevBtn.addEventListener('click', () => show(index - 1));
    nextBtn.addEventListener('click', () => show(index + 1));
    closeBtn.addEventListener('click', () => dialog.close());

    // Click the backdrop (i.e. the dialog itself, not its contents) to close.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(index + 1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(index - 1);
      }
    });

    // Restore focus to the thumbnail that opened the viewer.
    dialog.addEventListener('close', () => {
      lastFocused?.focus();
      img.src = '';
    });
  }
</script>

<style>
  .lightbox {
    width: min(100vw, 100%);
    max-width: none;
    max-height: none;
    height: 100%;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem);
    border: 0;
    background: rgba(4, 6, 14, 0.94);
    color: var(--text);
    display: none;
    place-items: center;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: clamp(0.5rem, 3vw, 2rem);
  }

  .lightbox[open] {
    display: grid;
  }

  .lightbox::backdrop {
    background: rgba(4, 6, 14, 0.9);
    backdrop-filter: blur(6px);
  }

  .lightbox__figure {
    margin: 0;
    display: grid;
    gap: 0.9rem;
    justify-items: center;
    max-height: 100%;
    min-width: 0;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: 78svh;
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .lightbox__caption {
    font-size: var(--step--1);
    color: var(--muted);
    text-align: center;
    max-width: 60ch;
  }

  .lightbox__nav,
  .lightbox__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--muted);
    cursor: pointer;
    transition: color var(--fast) var(--ease), border-color var(--fast) var(--ease);
  }

  .lightbox__nav {
    width: 48px;
    height: 64px;
    font-size: 2rem;
    line-height: 1;
  }

  .lightbox__nav:hover,
  .lightbox__close:hover {
    color: var(--cyan);
    border-color: var(--cyan-line);
  }

  .lightbox__nav[hidden] {
    visibility: hidden;
    display: inline-flex;
  }

  .lightbox__close {
    position: absolute;
    top: clamp(0.75rem, 2vw, 1.5rem);
    right: clamp(0.75rem, 2vw, 1.5rem);
    width: 44px;
    height: 44px;
    font-size: 1.6rem;
    line-height: 1;
  }

  .lightbox__counter {
    position: absolute;
    bottom: clamp(0.75rem, 2vw, 1.5rem);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    color: var(--faint);
    margin: 0;
  }

  @media (max-width: 620px) {
    .lightbox {
      grid-template-columns: minmax(0, 1fr);
    }

    .lightbox__nav {
      position: absolute;
      bottom: 3.5rem;
      width: 44px;
      height: 44px;
      font-size: 1.5rem;
    }

    .lightbox__nav--prev {
      left: 1rem;
    }

    .lightbox__nav--next {
      right: 1rem;
    }
  }
</style>
