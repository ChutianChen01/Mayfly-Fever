---
import { site, nav } from '../lib/site';
import { url } from '../lib/url';
import Icon from './Icon.astro';
import Email from './Email.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__name display">{site.name}</p>
      {site.location && <p class="muted site-footer__loc">{site.location}</p>}
      <ul class="social">
        {
          site.email && (
            <li>
              <Email email={site.email} class="social__link" label="Email me">
                <Icon name="mail" />
              </Email>
            </li>
          )
        }
        {
          site.links?.github && (
            <li>
              <a class="social__link" href={site.links.github} rel="me noopener" aria-label="GitHub">
                <Icon name="github" />
              </a>
            </li>
          )
        }
        {
          site.links?.linkedin && (
            <li>
              <a
                class="social__link"
                href={site.links.linkedin}
                rel="me noopener"
                aria-label="LinkedIn"
              >
                <Icon name="linkedin" />
              </a>
            </li>
          )
        }
        <li>
          <a class="social__link" href={url('/rss.xml')} aria-label="RSS feed">
            <Icon name="rss" />
          </a>
        </li>
      </ul>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container site-footer__base">
    <p class="muted">© {year} {site.name}</p>
    {site.footer_note && <p class="muted">{site.footer_note}</p>}
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section);
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, transparent, rgba(4, 6, 14, 0.6));
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  .site-footer__name {
    font-size: 1.05rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .site-footer__loc {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    margin-top: 0.35rem;
  }

  .social {
    display: flex;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin-top: 1.1rem;
  }

  .social__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--muted);
    text-decoration: none;
    transition: color var(--fast) var(--ease), border-color var(--fast) var(--ease),
      box-shadow var(--fast) var(--ease);
  }

  .social__link:hover,
  .social__link:focus-visible {
    color: var(--cyan);
    border-color: var(--cyan-line);
    box-shadow: 0 0 18px -6px rgba(34, 211, 238, 0.9);
  }

  .site-footer__nav ul {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-footer__nav a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }

  .site-footer__nav a:hover {
    color: var(--cyan);
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    padding-bottom: 1.75rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
  }
</style>
