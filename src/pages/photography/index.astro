---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { site } from '../../lib/site';
import { url, asset } from '../../lib/url';
import { getAlbums, albumCover, formatDate } from '../../lib/content';

const albums = await getAlbums();
const totalPhotos = albums.reduce((n, a) => n + a.data.photos.length, 0);
---

<Base title="Photography" description={`Photography by ${site.name}.`}>
  <PageHeader
    eyebrow="Light &amp; silver"
    title="Photography"
    lede="Not a portfolio, just somewhere to keep what I have been looking at. Grouped into rolls and wanderings rather than themes."
  />

  <section class="container albums-section">
    {
      albums.length === 0 ? (
        <div class="empty">
          <p>No albums yet. Create one under “Photo albums” in the CMS and drop some images in.</p>
        </div>
      ) : (
        <>
          <p class="meta albums-count">
            <span>{albums.length} {albums.length === 1 ? 'album' : 'albums'}</span>
            <span>{totalPhotos} {totalPhotos === 1 ? 'photograph' : 'photographs'}</span>
          </p>

          <div class="grid grid--3 albums">
            {albums.map((album, i) => {
              const cover = asset(albumCover(album));
              const count = album.data.photos.length;
              return (
                <article class="panel panel--link album" data-reveal data-reveal-delay={(i % 3) * 80}>
                  <div class="album__media">
                    {cover ? (
                      <img src={cover} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <div class="album__placeholder" aria-hidden="true">
                        <span>No photos yet</span>
                      </div>
                    )}
                    <span class="album__count">{count}</span>
                  </div>

                  <div class="album__body">
                    <h2 class="album__title display">
                      <a class="stretched" href={url(`/photography/${album.id}`)}>
                        {album.data.title}
                      </a>
                    </h2>
                    {album.data.description && (
                      <p class="muted album__desc">{album.data.description}</p>
                    )}
                    <p class="meta">
                      {album.data.date && (
                        <time datetime={album.data.date.toISOString()}>
                          {formatDate(album.data.date)}
                        </time>
                      )}
                      {album.data.location && <span>{album.data.location}</span>}
                    </p>
                  </div>
                </article>
              );
            })}
          </div>
        </>
      )
    }
  </section>
</Base>

<style>
  .albums-section {
    padding-bottom: var(--section);
  }

  .albums-count {
    margin-bottom: 1.75rem;
  }

  .album {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .album__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--abyss);
    border-bottom: 1px solid var(--line);
  }

  .album__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition: transform 800ms var(--ease), filter var(--slow) var(--ease);
  }

  .album:hover .album__media img {
    transform: scale(1.05);
    filter: saturate(1.05);
  }

  .album__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--faint);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      rgba(139, 157, 192, 0.05) 10px,
      rgba(139, 157, 192, 0.05) 20px
    );
  }

  .album__count {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    padding: 0.2rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--cyan);
    background: rgba(4, 6, 14, 0.75);
    border: 1px solid var(--cyan-line);
    border-radius: 999px;
    backdrop-filter: blur(4px);
  }

  .album__body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.25rem;
    flex: 1;
  }

  .album__title {
    font-size: 1.1rem;
    letter-spacing: 0.03em;
  }

  .album__title a {
    color: inherit;
    text-decoration: none;
  }

  .album:hover .album__title {
    color: var(--cyan);
  }

  .album__desc {
    flex: 1;
    font-size: var(--step--1);
  }
</style>
