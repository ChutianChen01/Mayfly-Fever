---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { url, asset } from '../../lib/url';
import { getPosts, formatDate, readingTime } from '../../lib/content';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // Posts are sorted newest-first, so the *next* post chronologically is
      // the one before it in the array.
      newer: posts[i - 1],
      older: posts[i + 1],
    },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { title, description, date, updated, tags, cover } = post.data;
const { Content } = await render(post);
const coverSrc = asset(cover);
---

<Base
  title={title}
  description={description}
  image={cover}
  type="article"
  publishedTime={date}
>
  <article class="container container--narrow post-page">
    <a class="back" href={url('/blog')}>
      <span aria-hidden="true">←</span> All writing
    </a>

    <header class="post-head">
      <div class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span>{readingTime(post.body)}</span>
      </div>

      <h1 class="display title-lg">{title}</h1>
      {description && <p class="lede">{description}</p>}

      {
        tags.length > 0 && (
          <ul class="tags post-head__tags">
            {tags.map((t) => (
              <li class="tag">#{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    {coverSrc && <img class="post-cover" src={coverSrc} alt="" loading="lazy" decoding="async" />}

    <div class="prose">
      <Content />
    </div>

    {
      updated && (
        <p class="updated meta">Updated {formatDate(updated)}</p>
      )
    }

    {
      (newer || older) && (
        <nav class="post-nav" aria-label="More posts">
          {older ? (
            <a class="post-nav__link" href={url(`/blog/${older.id}`)}>
              <span class="post-nav__label">← Older</span>
              <span class="post-nav__title">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a class="post-nav__link post-nav__link--next" href={url(`/blog/${newer.id}`)}>
              <span class="post-nav__label">Newer →</span>
              <span class="post-nav__title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>

<style>
  .post-page {
    padding-top: clamp(2rem, 6vw, 3.5rem);
    padding-bottom: var(--section);
  }

  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 2rem;
  }

  .back:hover {
    color: var(--cyan);
  }

  .post-head {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 2.5rem;
  }

  .post-head h1 {
    margin: 0.9rem 0 1rem;
  }

  .post-head__tags {
    margin-top: 1.5rem;
  }

  .post-cover {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    margin-bottom: 2.5rem;
  }

  .updated {
    margin-top: 2.5rem;
    font-style: italic;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: clamp(3rem, 7vw, 4.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .post-nav__link {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    transition: border-color var(--fast) var(--ease);
  }

  .post-nav__link:hover {
    border-color: var(--cyan-line);
  }

  .post-nav__link--next {
    text-align: right;
  }

  .post-nav__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .post-nav__title {
    font-size: var(--step--1);
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav__link--next {
      text-align: left;
    }
  }
</style>
